# ==============================================================================
# Git Ignore for LLMDet Vietnamese Food Project (SoPSoP)
# ==============================================================================

# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/

# Model Weights and Large Checkpoints (>100MB)
*.pth
*.pt
*.bin
*.safetensors
*.onnx
*.msgpack
*.h5
*.ot
work_dirs/
checkpoints/
weights/

# HuggingFace Pretrained Models
huggingface/

# Large Datasets and Archives
*.zip
*.tar
*.tar.gz
*.rar
vietnamese-food-dataset/
vietnamese_food_dataset_*.zip
vifood2.zip
vifood_2999_extracted/
crops_review/

# Heavy Raw Image Directories (Annotations in grounding_data/vifood/annotations are preserved)
grounding_data/vifood/images/
grounding_data/vifood/cache/

# Log files & Temporary Outputs
*.log
demo_output/

# Virtual Environments
.env
.venv/
env/
venv/
ENV/

# IDE and System Files
.vscode/
.idea/
.DS_Store
*.swp
*.swo
.git_sub_bak
.cache_vlm/
web_app.log

# ViFood-54: ảnh giải nén từ zip/images.zip
grounding_data/vifood54/images/
# ViFood-54: jsonl sinh lại được bằng scripts/vifood54 (build_vifood54, build_captions, make_ov_split); bản v1 là sao lưu
grounding_data/vifood54/annotations*/*.jsonl
grounding_data/vifood54/annotations_v1/
scripts/**/__pycache__/

# Temporary backups and logs
*.bak
*.bak*
*.bak_template
log_*.txt
